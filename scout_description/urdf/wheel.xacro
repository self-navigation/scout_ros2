<robot xmlns:xacro="http://ros.org/wiki/xacro" name="scout_wheel">
  <xacro:macro name="wheel" params="wheel_prefix wheel_diameter wheel_width axis *joint_pose">
    <xacro:property name="wheel_radius" value="${wheel_diameter / 2}"/>
    <link name="${wheel_prefix}_wheel_link">
      <inertial>
        <mass value="3"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.006564" ixy="0" ixz="0" iyy="0.006564" iyz="0" izz="0.0096"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://scout_description/meshes/wheel.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.08" length="0.084"/>
        </geometry>
      </collision>
    </link>
    <xacro:if value="${'$(arg sim)'}">
      <joint name="${wheel_prefix}_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="${wheel_prefix}_wheel_link"/>
        <xacro:insert_block name="joint_pose"/>
        <axis xyz="0 0 ${axis}" rpy="0 0 0"/>
        <dynamics damping="0.0" friction="0.0"/>
        <limit effort="1000" velocity="20"/>
        <!-- High limits for fast turns -->
      </joint>

      <gazebo reference="${wheel_prefix}_wheel_link">
        <!-- High for no longitudinal slip (propulsion). Never realized as 200:
             gazebo combines two contacting surfaces by taking the SMALLER
             coefficient, so this says "the wheel is never the longitudinal
             limit, the GROUND decides", which is what makes a friction patch's
             mu mean anything in the rolling direction. Leave it high. -->
        <mu1>200.0</mu1>
        <!-- Lateral grip. This one IS realized, and it sets the knee below which
             the robot cannot steer at all: a skid-steer yaws by gripping
             longitudinally while scrubbing sideways, so it needs mu_long > mu_lat,
             and an isotropic ground below this value caps BOTH channels and
             collapses the ratio to 1:1.

             Was 0.7 (concrete-ish) until 2026-08-07. That put the knee at the top
             of the realistic range for rubber, so EVERY plausible indoor floor
             (linoleum 0.45, wet tile 0.30, ice 0.05) landed at or below it and
             simulated "loses steering" rather than "slides". 0.45 moves the knee
             to linoleum, making tile and linoleum representable while reserving
             the collapse for ice, where a real skid-steer genuinely cannot steer.

             tools/sweep_ground_mu.sh measures the resulting chi-vs-ground-mu
             curve; re-run it if this changes, and re-measure
             PlannerConfig.slip_chi, which is a property of the resulting plant. -->
        <mu2>0.45</mu2>
        <!-- Small torsional slip for realism/stability -->
        <slip1>0.01</slip1>
        <!-- Lateral slip; tune higher (0.1) if turns feel too sticky -->
        <slip2>0.01</slip2>
        <!-- Stiffness: prevents sinking -->
        <kp>1e7</kp>
        <!-- Damping: reduces bounce; increased from 1.0 -->
        <kd>10.0</kd>
        <fdir1>1 0 0</fdir1>
        <!-- Deeper contacts for better force transmission -->
        <minDepth>0.005</minDepth>
        <maxContacts>10</maxContacts>
      </gazebo>
    </xacro:if>

    <xacro:unless value="${'$(arg sim)'}">
      <joint name="${wheel_prefix}_wheel" type="fixed">
        <parent link="base_link"/>
        <child link="${wheel_prefix}_wheel_link"/>
        <xacro:insert_block name="joint_pose"/>
      </joint>
    </xacro:unless>
  </xacro:macro>
</robot>
